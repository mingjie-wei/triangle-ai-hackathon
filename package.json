{
  "name": "duke-campus-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/manage.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/manage.ts seed",
    "sync:duke": "tsx --env-file-if-exists=.env scripts/manage.ts sync",
    "inventory:duke": "tsx --env-file-if-exists=.env scripts/manage.ts inventory"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "he": "2.0.0",
    "luxon": "3.7.2",
    "next": "16.4.5",
    "postgres": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/he": "1.2.3",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
