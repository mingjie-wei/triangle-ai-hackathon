# Copy to .env only if you do not already have one. Never commit credentials.
# Explicit saved demo; live mode never falls back to fixtures.
DATA_MODE=fixture
# Required for live discovery, seed, and sync; use your provider URL with TLS.
DATABASE_URL=
# Optional direct connection to the same database, used only by migrations.
DATABASE_MIGRATION_URL=
# Optional Bearer secret for POST /api/admin/sync; unset disables that endpoint.
SYNC_SECRET=
# Age of the last successful import before the live index is marked stale.
STALE_AFTER_HOURS=24

# Find events works in retrieval-only mode without a model key.
# Explore with AI needs the model enabled and configured.
# All provider and limiter variables are server-only. Never use NEXT_PUBLIC_.
CHAT_MODEL_ENABLED=false
DEEPSEEK_API_KEY=
# Set the exact model ID available to your account; no assumed default.
DEEPSEEK_MODEL=
# Production-mode model calls (including Preview/npm start) require Redis REST.
# Use dedicated credentials and an HTTPS endpoint.
CHAT_RATE_LIMIT_URL=
CHAT_RATE_LIMIT_TOKEN=
# Shared model request budget; valid range 1–100.
CHAT_MODEL_REQUESTS_PER_MINUTE=20

# Optional: export TEST_DATABASE_URL for a disposable test database only.
# npm test does not automatically load this file. Never use production.
