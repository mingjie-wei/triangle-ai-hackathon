# Copy to .env for local development. Explicit demo mode; never a live fallback.
DATA_MODE=fixture
DATABASE_URL=
DATABASE_MIGRATION_URL=
SYNC_SECRET=
STALE_AFTER_HOURS=24

# Ask Map works in retrieval-only mode without a model key.
# All provider and limiter variables are server-only. Never use NEXT_PUBLIC_.
CHAT_MODEL_ENABLED=false
DEEPSEEK_API_KEY=
# Exact DeepSeek model ID available to your account, e.g. deepseek-flash.
DEEPSEEK_MODEL=
# Production model calls require a shared Redis REST limit (e.g. Upstash).
# Use a dedicated database/credentials, with HTTPS.
CHAT_RATE_LIMIT_URL=
CHAT_RATE_LIMIT_TOKEN=
CHAT_MODEL_REQUESTS_PER_MINUTE=20
